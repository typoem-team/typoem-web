{
  "name": "typoem",
  "version": "0.1.0",
  "description": "친구들과 함께 영어 시와 소설을 읽고 생각을 나누는 공간",
  "main": "app.js",
  "type": "commonjs",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "fetch-poems": "node scripts/fetch-poems.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/so-yeon-333/typoem.git"
  },
  "keywords": [
    "poetry",
    "web",
    "express",
    "sqlite"
  ],
  "author": "Team 5 (Sihyun, Jiseop, Gyeongyoon, Soyeon)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/so-yeon-333/typoem/issues"
  },
  "homepage": "https://github.com/so-yeon-333/typoem#readme",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
