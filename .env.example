PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
DB_PATH=./typoem.db

# Turso (production DB). If both are empty, the local SQLite file at DB_PATH is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Extra allowed CORS origins (comma-separated). Default: https://localhost,capacitor://localhost,http://localhost
CORS_ORIGINS=
NODE_ENV=development

# Books (v1.1). Gutendex API base URL for book search (and metadata fallback). Default: https://gutendex.com
GUTENDEX_URL=
# Optional URL template with {id} for Project Gutenberg's RDF catalog file (book metadata).
# Empty -> https://www.gutenberg.org/cache/epub/{id}/pg{id}.rdf
GUTENBERG_RDF=
# Optional Project Gutenberg mirror for book text, as a URL template with {id}
# (e.g. https://mirror.example.org/cache/epub/{id}/pg{id}.txt). Empty -> use the URL Gutendex returns (gutenberg.org).
GUTENBERG_MIRROR=

# Render (production) notes:
#   - PORT is auto-injected by Render, do not set
#   - TURSO_DATABASE_URL / TURSO_AUTH_TOKEN must be set (data lives in Turso, not on Render's disk)
#   - NODE_ENV=production
#   - JWT_SECRET should be a different long random string from local